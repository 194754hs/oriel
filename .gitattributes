# Normalise line endings in the repository; check out native on each platform.
* text=auto

*.cpp  text
*.h    text
*.inc  text
*.md   text
*.txt  text
*.yml  text
*.html text
*.css  text

# PowerShell 5.1 reads a BOM-less .ps1 as ANSI, so these stay ASCII and CRLF.
*.ps1  text eol=crlf
*.cmd  text eol=crlf

*.png binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
